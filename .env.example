# Copy to .env and fill in your values.

# Free key from https://collegefootballdata.com
CFBD_API_KEY=

# Season to display (must be one of the ALLOWED_SEASONS in app/main.py)
SEASON_YEAR=2025

# Shared secret for POST /admin/refresh_token (used by the Render cron job)
REFRESH_TOKEN=

# Optional: SQLAlchemy DB URL. Defaults to sqlite:///./app.db
# DATABASE_URL=sqlite:///./app.db

# Optional: seconds to cache per-team points-for totals. Defaults to 900
# POINTS_FOR_TTL=900
